.review-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0;
  background: var(--paper);
}

.top-bar {
  padding: 20rpx 32rpx 8rpx;
}

.progress-text {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.progress-track {
  height: 8rpx;
  background: var(--line);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 999rpx;
}

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  padding: 24rpx 32rpx;
  gap: 16rpx;
}

.review-ai-tip {
  text-align: center;
}

.flashcard {
  width: 100%;
  min-height: 520rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}

.topic-chip {
  display: inline-block;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 28rpx;
}

.question {
  font-size: 40rpx;
  font-weight: 720;
  line-height: 1.45;
  color: var(--ink);
}

.hint {
  margin-top: 48rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 36rpx 0 24rpx;
}

.ans-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #8a6a1f;
  margin-bottom: 12rpx;
}

.ans-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--ink-soft);
  white-space: pre-wrap;
}

.action-dock {
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.btn-main-full {
  background: var(--accent);
  color: #fff;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 650;
  padding: 24rpx 0;
}

.rate-dock {
  display: flex;
  gap: 14rpx;
}

.rate {
  flex: 1;
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}

.rate-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.rate-sub {
  font-size: 20rpx;
  opacity: 0.75;
}

.bad {
  background: #f8e6e2;
  color: var(--danger);
}

.mid {
  background: #f7efd9;
  color: #8a6a1f;
}

.good {
  background: #dff1e8;
  color: var(--ok);
}

.theme-dark .bad {
  background: #3a2826;
  color: #e0a090;
}

.theme-dark .mid {
  background: #3a3424;
  color: #e0c06a;
}

.theme-dark .good {
  background: #243830;
  color: #7ecfc4;
}

.done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 48rpx;
  min-height: 100vh;
  background: var(--paper);
}

.done-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.done-icon.soft {
  background: var(--line);
  color: var(--muted);
}

.done-title {
  font-size: 40rpx;
  font-weight: 720;
  margin-bottom: 8rpx;
}

.done-btn {
  width: 100%;
  margin-top: 40rpx;
}
