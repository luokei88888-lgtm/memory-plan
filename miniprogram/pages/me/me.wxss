.page {
  padding: 24rpx 28rpx 48rpx;
  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
  box-sizing: border-box;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 8rpx;
  background: var(--card);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  background: transparent;
}

.profile-text {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 36rpx;
  font-weight: 720;
  color: var(--ink);
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.profile-sub {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.4;
}

.section-label {
  margin: 28rpx 8rpx 14rpx;
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 500;
}

.cell-group {
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  box-sizing: border-box;
}

.cell:last-child {
  border-bottom: none;
}

.cell-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-align: left;
}

.cell-title {
  font-size: 30rpx;
  font-weight: 650;
  color: var(--ink);
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.cell-desc {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-arrow {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 34rpx;
  line-height: 1;
  font-weight: 400;
  width: 28rpx;
  text-align: right;
}

.cell-theme {
  gap: 20rpx;
}

.cell-theme-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.theme-switch {
  flex-shrink: 0;
  margin-left: 8rpx;
  transform: scale(0.92);
  transform-origin: center right;
}

.cell-share-row {
  position: relative;
}

.share-hotspot {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
}

.share-hotspot::after {
  border: none;
}

.cell.tip {
  justify-content: flex-start;
  gap: 18rpx;
  padding: 26rpx 28rpx;
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2f6f6a;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  color: #3d5166;
  font-size: 28rpx;
  line-height: 1.55;
}
