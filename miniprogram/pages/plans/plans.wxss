.page {
  padding: 24rpx 28rpx 40rpx;
  min-height: 100vh;
  background: var(--paper);
}

.tabs {
  display: flex;
  background: #e8eef2;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--muted);
  font-weight: 600;
}

.tab-on {
  background: #fff;
  color: var(--ink);
  box-shadow: 0 4rpx 12rpx rgba(28, 43, 58, 0.08);
}

.plan-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 8rpx;
}

.plan-goal {
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-side {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.status-pill {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 650;
}

.status-active {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.status-draft {
  background: #e8eef2;
  color: #4a6670;
}

.status-pending_confirm {
  background: #f7efd9;
  color: #8a6a1f;
}

.status-paused {
  background: #f7efd9;
  color: #8a6a1f;
}

.status-archived,
.status-completed {
  background: #e8eef2;
  color: var(--muted);
}

.arrow {
  color: var(--muted);
  font-size: 36rpx;
}

.empty-box {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 10rpx;
}

.btn-link {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #fff;
  font-weight: 650;
  font-size: 28rpx;
}
